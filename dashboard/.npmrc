# @cloudflare/next-on-pages@1.13.x peer-requires next >=14.3.0, but this project
# pins next@14.2.35. The two work together in practice; accept the peer mismatch so
# every `npm install` — including the one Vercel's build runs INSIDE next-on-pages
# (which we can't pass a flag to) — resolves instead of ERESOLVE-failing. This
# mirrors the local deploy's explicit `npm install --legacy-peer-deps`.
legacy-peer-deps=true
